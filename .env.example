# ============================================================
# RescueAI 环境变量示例
# 用法：复制为 backend/.env 后填入真实值
#   cp .env.example backend/.env
# 注意：.env 已被 .gitignore 排除，任何真实密钥绝不提交入库
# ============================================================

# ---------- JWT 鉴权（标准平台 backend/app 使用） ----------

# JWT 签名密钥：生产环境务必更换为随机长字符串
SECRET_KEY=your-secret-key-change-in-production

# JWT 过期时间（分钟），默认 30
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT 签名算法，默认 HS256
ALGORITHM=HS256

# ---------- 数据库（标准平台 backend/app 使用） ----------

# SQLAlchemy 数据库连接串，默认本地 SQLite
DATABASE_URL=sqlite:///./aidisaster.db

# ---------- 阿里云 DashScope（通义千问，主演示载体 backend/Qwen 初版 使用） ----------

# DashScope API Key：在阿里云百炼平台自备
# 无密钥时可用 ?sim=1 离线演示模式（零 AI 请求）
DASHSCOPE_API_KEY=sk-your-key-here

# 文本模型（灾情简报 / 优先级理由 / 复盘参谋等）
DASHSCOPE_TEXT_MODEL=qwen3.8-max

# 视觉模型（Qwen-VL 结构研判）
DASHSCOPE_VL_MODEL=qwen3.7-plus

# ---------- 主演示代理可选参数（ai_proxy.py） ----------

# 代理监听地址，默认 127.0.0.1 仅本机；投屏设备访问时设为 0.0.0.0
#RESCUE_AI_PROXY_HOST=127.0.0.1

# 代理端口，默认 8010（避开标准平台 FastAPI 的 8000）
#RESCUE_AI_PROXY_PORT=8010

# ---------- Playwright 验收脚本（pw-test）使用的本地演示账号 ----------

# 仅用于本机 localhost:8000 登录取 token 截图，请填入你本地初始化的演示账号
RESCUEAI_DEMO_USER=
RESCUEAI_DEMO_PWD=
